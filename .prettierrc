{
  "semi": true,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "all",
  "printWidth": 100,
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": "*.yml",
      "options": { "singleQuote": false }
    },
    {
      "files": "*.md",
      "options": { "printWidth": 80 }
    }
  ]
}
